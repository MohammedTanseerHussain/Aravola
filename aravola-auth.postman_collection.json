{
  "info": {
    "_postman_id": "b6f0b7a1-6e2d-4a8e-9f7c-3c1a0f0e5a11",
    "name": "Aravola Auth API",
    "description": "OTP signup, password creation, login, session check and logout.\n\nRun from the terminal with the Postman CLI. See docs/API.md for the exact commands.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "you@example.com",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "StrongPass1!",
      "type": "string"
    },
    {
      "key": "verificationToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Check",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('service is healthy', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.ok).to.eql(true);",
                  "  pm.expect(body.data.status).to.eql('healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "First-time signup",
      "item": [
        {
          "name": "Request OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('OTP email accepted and verify page returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.ok).to.eql(true);",
                  "  pm.expect(body.data.email).to.eql(pm.variables.get('email').trim().toLowerCase());",
                  "  pm.expect(body.data.redirectTo).to.include('/verify-otp');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/request-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "request-otp"]
            }
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = String(pm.variables.get('email') || '').trim();",
                  "const otp = String(pm.variables.get('otp') || '').trim();",
                  "",
                  "if (!email.includes('@')) {",
                  "  throw new Error('Set the recipient email first: --env-var \"email=you@example.com\"');",
                  "}",
                  "",
                  "if (!/^\\d{6}$/.test(otp)) {",
                  "  throw new Error('Set the 6-digit code from the email: --env-var \"otp=123456\"');",
                  "}",
                  "",
                  "pm.collectionVariables.set('email', email.toLowerCase());",
                  "pm.collectionVariables.set('otp', otp);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('verification token returned', () => {",
                  "  pm.expect(body.ok).to.eql(true);",
                  "  pm.expect(body.data.verificationToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (pm.response.code === 200 && body.data?.verificationToken) {",
                  "  pm.collectionVariables.set('verificationToken', body.data.verificationToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            }
          },
          "response": []
        },
        {
          "name": "Create password",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('verificationToken')) {",
                  "  throw new Error('No verification token. Run \"Verify OTP\" in the same collection run.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('account and session created', () => {",
                  "  pm.expect(body.ok).to.eql(true);",
                  "  pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(body.data.sessionToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (pm.response.code === 201 && body.data?.sessionToken) {",
                  "  pm.collectionVariables.set('sessionToken', body.data.sessionToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verificationToken\": \"{{verificationToken}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/create-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "create-password"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Returning user",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('signed in and session token returned', () => {",
                  "  pm.expect(body.ok).to.eql(true);",
                  "  pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(body.data.sessionToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (pm.response.code === 200 && body.data?.sessionToken) {",
                  "  pm.collectionVariables.set('sessionToken', body.data.sessionToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('returns the signed-in user', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.ok).to.eql(true);",
                  "  pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(body.data.sessionExpiresAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('session revoked', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.ok).to.eql(true);",
                  "  pm.expect(body.message).to.include('Signed out');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          },
          "response": []
        },
        {
          "name": "Me after logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 401', () => pm.response.to.have.status(401));",
                  "",
                  "pm.test('revoked token is rejected', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.ok).to.eql(false);",
                  "  pm.expect(body.error.code).to.eql('SESSION_INVALID');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
