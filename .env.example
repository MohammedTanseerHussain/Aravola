# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=Aravola
DATABASE_PATH=./data/auth.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Set to 1 when the API is behind exactly one trusted reverse proxy
# (Render, Railway, Fly.io, nginx, etc.). Keep 0 for local development.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Frontend pages (replace these with the links from your React developer)
# ---------------------------------------------------------------------------
# The API returns these URLs as "redirectTo" after each successful step.
# FRONTEND_OTP_VERIFY_URL is the page where the user enters the OTP.
# FRONTEND_CREATE_PASSWORD_URL is optional. It is only used if your React app
# has a separate password page. The recommended flow collects email + password
# first, sends the OTP, and calls create-password immediately after verify-otp.
FRONTEND_OTP_VERIFY_URL=http://localhost:5173/verify-otp
FRONTEND_CREATE_PASSWORD_URL=http://localhost:5173/create-password

# ---------------------------------------------------------------------------
# Secrets and OTP settings
# ---------------------------------------------------------------------------
# REQUIRED. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse or commit the real value.
OTP_PEPPER=replace_with_a_random_value_of_at_least_32_characters

OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
VERIFICATION_TOKEN_EXPIRY_MINUTES=15
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Sending email (SMTP)
# ---------------------------------------------------------------------------
# Works with any SMTP provider. A transactional provider on a domain you own
# gives the best chance of landing in the inbox. See README.md.
#
# SMTP_AUTH_TYPE:
#   password - Brevo, Resend, SendGrid, Mailgun, etc.
#   oauth2   - Gmail with OAuth2 (no App Password)
SMTP_AUTH_TYPE=password
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=

# Only used when SMTP_AUTH_TYPE=oauth2.
# See "Gmail OAuth2" in README.md for how to create these values.
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=

# Switching to the company sender later requires no code changes:
# - With Brevo: authenticate the company domain, then change MAIL_FROM only.
# - With the company SMTP server: change SMTP_HOST, SMTP_PORT, SMTP_SECURE,
#   SMTP_REQUIRE_TLS, SMTP_USER, SMTP_PASS and MAIL_FROM.

# Must be an address/domain authenticated with your email provider.
# Example: "Aravola <no-reply@yourdomain.com>"
MAIL_FROM="Aravola <no-reply@example.com>"
MAIL_REPLY_TO=
SMTP_TIMEOUT_MS=10000
